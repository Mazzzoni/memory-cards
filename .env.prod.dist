# Compose settings of the production server (mazzvps): copy to .env next to compose.yaml, never commit .env.
# No secret here (the apps' settings are in workspaces/*/.env.local).

# Production overlay (restart policy, log rotation).
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The compose project name the server has always used (it names the containers and the images).
COMPOSE_PROJECT_NAME=memory-cardsmazzlol

# Ports Caddy proxies to (127.0.0.1): the client, and the Socket.IO server behind /wsapi*.
HTTP_PORT=3876
API_PORT=3875
