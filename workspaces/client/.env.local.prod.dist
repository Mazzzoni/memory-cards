# workspaces/client/.env.local of the production server (mazzvps): copy to .env.local next to it, fill from
# Bitwarden (Mazz/Servers › mazzvps · ~/projects/memory-cards.mazz.lol/workspaces/client/.env.local), never commit
# it. The client image copies it at build time; Next.js inlines the NEXT_PUBLIC_* values (public).

# The Socket.IO server's public URL (Caddy routes /wsapi* to the server container).
NEXT_PUBLIC_WS_API_URL=

# Self-hosted Plausible: origin and site name.
NEXT_PUBLIC_PLAUSIBLE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
